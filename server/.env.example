# Copy this file to .env and fill in your own values. Never commit .env.

# Local PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# If the password has special characters (@ : / # ? &), URL-encode them.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/maisoncremalie?schema=public"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Signs admin login tokens. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
